# --- Build outputs ---
/bin/
*.exe
*.test
*.out
coverage.*
dist/
# ...but keep the embed placeholder so `//go:embed all:dist` resolves in a fresh clone
!backend/web/dist/
backend/web/dist/*
!backend/web/dist/.gitkeep

# --- Go ---
# Binaries from `go build` in module root
/backend/backend
/backend/server

# --- Local SQLite database ---
*.db
*.db-shm
*.db-wal
# Test caches & profiling
*.prof
go.work
go.work.sum
vendor/

# --- Node / Bun ---
node_modules/
.pnp.*
.yarn/cache
.yarn/install-state.gz
.npm
.bun

# --- Vite / framework caches ---
.vite/
.output/
.wrangler/
.vercel/
.netlify/

# --- Environment / secrets ---
.env
.env.*
!.env.example

# --- Editors / IDEs ---
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# --- OS noise ---
.DS_Store
Thumbs.db
desktop.ini

# --- Tooling ---
.air.toml.local
tmp/
.cache/

# --- Logs ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
bun-debug.log*
