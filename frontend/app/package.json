{
  "name": "solid-fiber",
  "version": "0.0.0",
  "description": "Solid + UnoCSS (preset-wind4) + Fiber themed starter",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc --noEmit --skipLibCheck && vite build",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "serve": "vite preview"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/user-event": "^14.6.1",
    "@unocss/preset-wind4": "^66.7.5",
    "@unocss/vite": "^66.7.5",
    "eslint": "^10.7.0",
    "eslint-plugin-solid": "^0.14.5",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "solid-devtools": "^0.34.5",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vite-plugin-solid": "^2.11.13",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "solid-js": "^1.9.14"
  }
}
