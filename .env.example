# Copy to .env to override defaults used by docker-compose.yml.
# .env is gitignored; .env.example is committed as documentation.

# Address (host:port) the Fiber server binds to inside the container.
ADDR=:3000

# Path to the SQLite database file. In the container this lives under the
# /data volume so it persists across restarts; locally it defaults to
# ./work_items.db when unset.
DB_PATH=/data/work_items.db
